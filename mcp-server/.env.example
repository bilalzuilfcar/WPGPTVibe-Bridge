NODE_ENV=production
PORT=8787

# Central application secrets.
MCP_API_KEY=replace-with-at-least-32-random-bytes
WPGPTVIBE_MASTER_KEY=replace-with-exactly-64-hex-characters
WPGPTVIBE_SESSION_SECRET=replace-with-at-least-32-random-bytes

# Production persistence. MySQL is recommended; file storage remains available for local development.
DATABASE_URL=mysql://user:password@127.0.0.1:3306/wpgptvibe
WPGPTVIBE_DATA_DIR=./data

# Admin control plane.
WPGPTVIBE_ADMIN_USERNAME=admin
WPGPTVIBE_ADMIN_PASSWORD_HASH=scrypt$replace$with-generated-hash
WPGPTVIBE_COOKIE_SECURE=true

# Optional browser QA. Requires Playwright Chromium to be installed on the host.
WPGPTVIBE_BROWSER_TESTING=false
WPGPTVIBE_BROWSER_TIMEOUT_MS=15000

# Used only by npm run site:add. Never commit real values.
WPGPTVIBE_SITE_ID=
WPGPTVIBE_SITE_NAME=
WPGPTVIBE_SITE_URL=
WPGPTVIBE_SITE_TOKEN=
